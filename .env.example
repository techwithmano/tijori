# ==============================================================================
# Tijori (تجوري) - Environment Variables Configuration
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit your actual .env or .env.local to version control!
# ==============================================================================

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tijori?retryWrites=true&w=majority"
# Optional direct replica set URI (for restricted networks / Windows DNS SRV limitations)
# MONGODB_DIRECT_URI="mongodb://<username>:<password>@host1:27017,host2:27017/tijori?ssl=true&replicaSet=<rs>&authSource=admin"

# Authentication & Security
JWT_SECRET="<generate-a-strong-random-32-byte-hex-string-for-production>"
CRON_SECRET="<generate-a-strong-random-secret-for-cron-job-authorization>"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI (Google Gemini API - optional, graceful offline GCC roasts if omitted)
GEMINI_API_KEY="AIzaSy..."

# Transactional Emails (Resend API - optional for Keyholder invitations)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Tijori <onboarding@resend.dev>"
# Optional: verified account email for Resend sandbox test forwards
# RESEND_ACCOUNT_EMAIL="your-verified-account@example.com"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
